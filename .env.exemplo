ANS_ANOS_CARGA_HOT=2
API_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PUBLIC_URL=http://localhost:5173

# Stripe Checkout (não preencher com chaves reais neste arquivo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SANDBOX=
STRIPE_PRICE_PILOTO=
STRIPE_PRICE_CORE_API=

# Stripe self-service checkout (frontend — planos self-service)
VITE_STRIPE_CHECKOUT_STARTER_URL=
VITE_STRIPE_CHECKOUT_PRO_URL=
VITE_STRIPE_CHECKOUT_MAX_URL=

# pgBackRest — Repositório externo S3-compatible (Sprint 39 / HIS-39.3)
# Nunca preencher com valores reais neste arquivo (está no git).
# Na VPS: copiar para /etc/healthintel/pgbackrest.env com chmod 600.
PGBACKREST_REPO2_ENDPOINT=
PGBACKREST_REPO2_BUCKET=
PGBACKREST_REPO2_REGION=
PGBACKREST_REPO2_KEY=
PGBACKREST_REPO2_KEY_SECRET=
PGBACKREST_REPO2_CIPHER_PASS=

# Diretório de dados do PostgreSQL na VPS (ex: /var/lib/postgresql/16/main)
POSTGRES_DATA_DIR=

# Email transacional (formulário de contato comercial)
# Configurar para que o backend dispare email ao receber leads do site.
# Para Gmail: usar "app password" (https://myaccount.google.com/apppasswords)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=projetosdatabricksfree@gmail.com
EMAIL_SMTP_PASSWORD=<app_password_gmail_16_chars>
EMAIL_SMTP_FROM_NAME=HealthIntel Contato
EMAIL_CONTATO_DESTINO=projetosdatabricksfree@gmail.com
