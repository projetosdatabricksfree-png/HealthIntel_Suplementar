FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG VITE_API_BASE_URL
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_STRIPE_CHECKOUT_STARTER_URL
ARG VITE_STRIPE_CHECKOUT_PRO_URL
ARG VITE_STRIPE_CHECKOUT_MAX_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_STRIPE_CHECKOUT_STARTER_URL=$VITE_STRIPE_CHECKOUT_STARTER_URL
ENV VITE_STRIPE_CHECKOUT_PRO_URL=$VITE_STRIPE_CHECKOUT_PRO_URL
ENV VITE_STRIPE_CHECKOUT_MAX_URL=$VITE_STRIPE_CHECKOUT_MAX_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
